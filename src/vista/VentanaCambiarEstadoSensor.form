<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="vista.VentanaCambiarEstadoSensor">
  <grid id="10001" binding="contentPane" layout-manager="GridBagLayout">
    <constraints>
      <xy x="20" y="20" width="350" height="220"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <component id="10002" class="javax.swing.JLabel">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
          <gridbag top="4" left="7" bottom="4" right="7" weightx="0.0" weighty="0.0"/>
        </constraints>
        <properties>
          <text value="Estacion:"/>
        </properties>
      </component>
      <component id="10003" class="javax.swing.JComboBox" binding="comboEstaciones">
        <constraints>
          <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
          <gridbag top="4" left="7" bottom="4" right="7" weightx="1.0" weighty="0.0"/>
        </constraints>
        <properties>
          <model/>
        </properties>
      </component>
      <component id="10004" class="javax.swing.JLabel">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
          <gridbag top="4" left="7" bottom="4" right="7" weightx="0.0" weighty="0.0"/>
        </constraints>
        <properties>
          <text value="Sensor:"/>
        </properties>
      </component>
      <component id="10005" class="javax.swing.JComboBox" binding="comboSensores">
        <constraints>
          <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
          <gridbag top="4" left="7" bottom="4" right="7" weightx="1.0" weighty="0.0"/>
        </constraints>
        <properties/>
      </component>
      <component id="10006" class="javax.swing.JLabel">
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
          <gridbag top="4" left="7" bottom="4" right="7" weightx="0.0" weighty="0.0"/>
        </constraints>
        <properties>
          <text value="Estado actual:"/>
        </properties>
      </component>
      <component id="10007" class="javax.swing.JLabel" binding="labelEstadoActual">
        <constraints>
          <grid row="2" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
          <gridbag top="4" left="7" bottom="4" right="7" weightx="0.0" weighty="0.0"/>
        </constraints>
        <properties>
          <text value="-"/>
        </properties>
      </component>
      <component id="10008" class="javax.swing.JLabel">
        <constraints>
          <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
          <gridbag top="4" left="7" bottom="4" right="7" weightx="0.0" weighty="0.0"/>
        </constraints>
        <properties>
          <text value="Nuevo estado:"/>
        </properties>
      </component>
      <grid id="10009" binding="panelEstados" layout-manager="FlowLayout" hgap="5" vgap="3" flow-align="0">
        <constraints>
          <grid row="3" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
          <gridbag top="4" left="7" bottom="4" right="7" weightx="1.0" weighty="0.0"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children/>
      </grid>
      <grid id="1000a" layout-manager="FlowLayout" hgap="5" vgap="3" flow-align="2">
        <constraints>
          <grid row="4" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
          <gridbag top="4" left="7" bottom="4" right="7" weightx="1.0" weighty="0.0"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="1000b" class="javax.swing.JButton" binding="cambiarEstadoButton">
            <constraints/>
            <properties>
              <text value="Cambiar estado"/>
            </properties>
          </component>
          <component id="1000c" class="javax.swing.JButton" binding="cancelarButton">
            <constraints/>
            <properties>
              <text value="Cancelar"/>
            </properties>
          </component>
        </children>
      </grid>
    </children>
  </grid>
</form>
